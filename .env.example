# Existing backend connection and shared admin credential (do not commit secrets)
DATABASE_URL=
ADMIN_TOKEN=
PORT=3000
NODE_ENV=production
# Exact HTTPS origin serving this Express app; required for dashboard mutations in production
DASHBOARD_ORIGIN=https://your-backend.onrender.com
STAFF_OWNER_EMAIL=info@feliciabakes.co.za
STAFF_OWNER_PASSWORD=
STAFF_DEVELOPER_EMAIL=dev@feliciabakes.co.za
STAFF_DEVELOPER_PASSWORD=
# Enable only after staff-recovery-schema.sql is approved/applied and Brevo delivery tested.
# The reset email goes only to the configured owner/developer email above.
STAFF_RECOVERY_ENABLED=false
MAILBOX_ADDRESS=info@feliciabakes.co.za
# Provider-specific adapter is not configured yet. Never enable demo in production.
DASHBOARD_DEMO=false

# Get exact host names from cPanel > Email Accounts > Connect Devices
MAIL_CONNECTION_ENABLED=false
MAIL_SEND_ENABLED=false
MAIL_IMAP_HOST=mail.feliciabakes.co.za
MAIL_SMTP_HOST=mail.feliciabakes.co.za
MAIL_SMTP_PORT=465
MAILBOX_PASSWORD=
# Do not set on Render Free; deployment decision still required
RENDER_SMTP_CONFIRMED=false

# Chosen free-host-compatible sending route. No SMTP needed for Brevo HTTPS.
MAIL_SEND_TRANSPORT=brevo
BREVO_API_KEY=
BREVO_SENDER_ID=
BREVO_FELICIA_LIST_ID=
BREVO_FELICIA_LIST_VERIFIED=false
BREVO_CAMPAIGN_DRAFTS_ENABLED=false
BREVO_FREE_SENDING_CONFIRMED=false

# Optional base64 equivalents from the private helper (encoding, not encryption)
STAFF_OWNER_PASSWORD_B64=
STAFF_DEVELOPER_PASSWORD_B64=
MAILBOX_PASSWORD_B64=
BREVO_API_KEY_B64=

# Optional automatic quote notification
RESEND_API_KEY=
EMAIL_FROM=Felicia Bakes <orders@feliciabakes.co.za>
ORDER_NOTIFICATION_EMAIL=dev@feliciabakes.co.za
